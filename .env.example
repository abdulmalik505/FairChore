# FairChore Environment Variables
# Copy this file to .env and fill in your values.
# .env is never committed to git.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fairchore

# Secret key for JWT signing — use a long random string
SECRET_KEY=replace-this-with-a-long-random-string

# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:3000

# Set to "true" only during local development to enable Flask debug mode
FLASK_DEBUG=false


